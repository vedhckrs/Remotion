# Hosted Vercel variables (set independently; never commit real values):
NURADI_ADMIN_PASSWORD=
NURADI_SESSION_SECRET=
NURADI_WORKER_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Mac-only configuration; use the same worker token as the hosted site:
NURADI_SITE_URL=https://nuradi.co.in
NURADI_LOCAL_URL=http://127.0.0.1:4545
# Optional: absolute path to worker journal in the local rendering project
# NURADI_WORKER_JOURNAL=/absolute/project/automation/remote-worker.json
